import java.util.*;

class Main {
    public static void main(String[] args) {
        Scanner s = new Scanner(System.in);
        String input = s.nextLine();
        int V = 0;
        int C = 0;
        
        for(char ch : input.toCharArray()){
            if(Character.isLetter(ch)){
                if("aeiou".indexOf(ch) != -1){
                    V++;
                }else{
                    C++;
                }
            }
        }
        System.out.println(V + " " + C);
    }
}

