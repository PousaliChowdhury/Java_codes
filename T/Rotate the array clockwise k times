import java.util.*;

class Main {
    public static void main(String[] args) {
        Scanner s = new Scanner(System.in);
        int n = s.nextInt();
        int arr[] = new int[n];
        
        for(int i=0; i<n; i++){
            arr[i] = s.nextInt();
        }
        int k = s.nextInt();
        
        if(k>n){
            k = k % n;
        }
        
        int ans[] = new int[n];
        for(int i=0; i<k; i++){
            ans[i] = arr[n-k+i];
        }
        
        int index = 0;
        for(int i=k; i<n; i++){
            ans[i] = arr[i-k];
        }
        
        for(int i=0; i<n; i++){
            System.out.print(ans[i] + " ");
        }
            
    }
}


