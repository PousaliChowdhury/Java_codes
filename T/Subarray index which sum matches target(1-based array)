
import java.util.*;

class Main {
    public static void main(String[] args) {
        Scanner s = new Scanner(System.in);
        int n = s.nextInt();
        int arr[] = new int[n];
        int target = s.nextInt();
        
        ArrayList<Integer> ans = new ArrayList<>();
        
        for(int i=0;i<n; i++){
            arr[i] = s.nextInt();
        }
        
        
        for(int i=0; i<n; i++){
            int sum = 0;
            for(int j=i; j<n; j++){
                sum += arr[j];
                if(sum == target){
                    ans.add(i+1);
                    ans.add(j+1);
                    System.out.println(ans);
                    return;
                }
            }
        }
        System.out.println("-1");
    }
}


