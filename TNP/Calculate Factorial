import java.util.*;

class Main {
    public static void main(String[] args) {
        Scanner s = new Scanner(System.in);
        int n = s.nextInt();
        long fact = 1;
        
        for(int i=2; i<=n; i++){
            fact = fact*i;
        }
        System.out.println(fact);
    }
}

