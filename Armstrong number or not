import java.util.*;

class Main {
    public static void main(String[] args) {
        Scanner s = new Scanner(System.in);
        int n = s.nextInt();
        int original = n;
        int x = Integer.toString(n).length();
        int res = 0;
        
        while(n != 0){
            int rem = n % 10;
            res += Math.pow(rem, x);
            n = n/10;
        }
        if(res == original)
            System.out.println("Yes");
        else
            System.out.println("No");
    }
}


