// T number of test cases, P, Q, R are 3 numbers select 2 and add 1 with them and the remaining number subtract 1, do this unless until P=Q=R

import java.util.*;

public class Main{
    public static int minSteps(int P, int Q, int R){
        int arr[] = {P, Q, R};
        Arrays.sort(arr);
        
        if(arr[0] == arr[1] && arr[1] == arr[2]){
            return 0;
        }
        
        int steps = 0;
        while(true){
            arr[0] += 1;
            arr[1] += 1;
            arr[2] -= 1;
            steps++;
            Arrays.sort(arr);
            
            if(arr[0] == arr[1] && arr[1] == arr[2]){
                return steps;
            }
            
            if((arr[1] == arr[2] && arr[0] + 1 == arr[1]) || 
            (arr[0] == arr[1] && arr[1] + 1 == arr[2])){
                return -1;
            }
        }
        
        
    }
    
    public static void main(String args[]){
        Scanner s = new Scanner(System.in);
        int T = s.nextInt();
        while(T-- > 0){
            int P = s.nextInt();
            int Q = s.nextInt();
            int R = s.nextInt();
            
            System.out.println(minSteps(P, Q, R));
        }
        s.close();
    }
}


