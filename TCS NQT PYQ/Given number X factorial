import java.util.*;

class Main {
    public static void main(String[] args) {
        Scanner s = new Scanner(System.in);
        int x = s.nextInt();
        
        int fact = 1;
        for(int i=1; i<=x; i++){
            fact *= i;
        }
        System.out.println(fact);
    }
}

