
import java.util.*;

class Main {
    public static void main(String[] args) {
        Scanner s = new Scanner(System.in);
        int n = s.nextInt();
        int a = s.nextInt();
        int d = s.nextInt();
        
        int sum = 0;
        for(int i=1; i<=n; i++){
            sum = n / 2  * (2*a + (n-1) * d);
        }
        
        System.out.println(sum);
    }
}

