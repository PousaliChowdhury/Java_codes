
import java.util.*;

class Main {
    public static void main(String[] args) {
        Scanner s = new Scanner(System.in);
        int n = s.nextInt();
        int arr[][] = new int[n][n];
        
        for(int i=0;i<n; i++){
            for(int j=0;i<n; i++){
                arr[i][j] = s.nextInt();
            }
        }
        
        // transpose
        for(int i=0; i<n; i++){
            for(int j=i+1; j<n; j++){
                int temp = arr[i][j];
                arr[i][j] = arr[j][i];
                arr[j][i] = temp;
            }
        }
        
        //reverse
        for(int j=0; j<n; j++){
            int top = 0; 
            int bottom = n-1;
            while(top<bottom){
                int temp = arr[top][j];
                arr[top][j] = arr[bottom][j];
                arr[bottom][j] = temp;
                
                top++;
                bottom--;
            }
        }
        
        for(int [] row :arr){
            System.out.println(Arrays.toString(row));
        }
        
    }
}
