import java.util.*;

class Main {
    public static void main(String[] args) {
        Scanner s = new Scanner(System.in);
        int n = s.nextInt();
        int arr[] = new int[n];
        
        for(int i=0; i<n; i++){
            arr[i] = s.nextInt();
        }
        
        int MaxFreq = 0;
        int MostFreqNum = -1;
        
        Map<Integer,Integer> FrequencyMap = new HashMap<>();
        
        for(int num:arr){
            int freq = FrequencyMap.getOrDefault(num,0)+1;
            FrequencyMap.put(num, freq);
            if(freq > MaxFreq){
                 MaxFreq = freq;
                 MostFreqNum = num;
            }
        }
        
        System.out.println(MostFreqNum + "->" + MaxFreq);
    }
}

