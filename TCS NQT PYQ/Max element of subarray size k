import java.util.*;

class Main {
    public static void main(String[] args) {
        Scanner s = new Scanner(System.in);
        int n = s.nextInt();
        int arr[] = new int[n];
        
        for(int i=0; i<n; i++){
            arr[i] = s.nextInt();
        }
        int k = s.nextInt();
        int max = 0;
        ArrayList<Integer> input = new ArrayList<>();
        
        for(int i=0; i<=n-k; i++){
            max = arr[i];
            for(int j=i; j<i+k; j++){
                if(max < arr[j]){
                    max = arr[j];
                }
            }
            input.add(max);
        }
        System.out.println(input);
    }
}

