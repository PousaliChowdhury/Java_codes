import java.util.*;

public class Main{
    public static void main(String args[]){
        Scanner s = new Scanner(System.in);
        int n = s.nextInt();
        
        int arr[][] = new int[n][n];
        for(int i=0; i<n; i++){
            for(int j=0; j<n; j++){
                arr[i][j] = s.nextInt();
            }
        }
        int x = s.nextInt();
        int i = 0, j = n-1;
        
        while(i<n && j>=0){
                if(arr[i][j] == x){
                  System.out.println("Element found at (" + i + "," + j + ")");
                    return;
                }
                else if(arr[i][j] > x)
                    j--;
                else
                    i++;
        }
        
        System.out.println("Element not found");

        
    }
}
